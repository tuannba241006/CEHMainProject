<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
                <env name="DB_CONNECTION" value="mysql" force="false"/>
        <env name="DB_HOST" value="db" force="false"/>
        <env name="DB_PORT" value="3306" force="false"/>
        <env name="DB_USERNAME" value="ceh_user" force="false"/>
        <env name="DB_PASSWORD" value="ceh_local_password" force="false"/>
        <!-- Luôn ép ceh_test để không bao giờ ghi vào database dev -->
        <env name="DB_DATABASE" value="ceh_test" force="true"/>
        <server name="DB_DATABASE" value="ceh_test"/>
        <env name="DB_URL" value=""/>
    </php>
</phpunit>
