{
  "info": {
    "_postman_id": "ceh-phase-1-auth-collection-v1",
    "name": "Campus Event Hub (CEH) - Phase 1: Auth & Account Module",
    "description": "Postman Collection hoàn chỉnh cho Phase 1: Phân hệ Xác thực & Quản lý Tài khoản (UC-AUTH-01 -> UC-AUTH-05, UC-ADM-01). Chuẩn API OpenAPI v3.2.3 và kiến trúc Unified Envelope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Đăng ký & Kích hoạt Sinh viên (UC-AUTH-01)",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản Sinh viên qua Email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ho_ten\": \"Nguyễn Văn A\",\n  \"mssv\": \"22521199\",\n  \"email\": \"22521199@gm.uit.edu.vn\",\n  \"mat_khau\": \"SinhVien@123\",\n  \"mat_khau_confirmation\": \"SinhVien@123\",\n  \"lop_sinh_hoat\": \"HTTT2022\",\n  \"khoa\": \"Khoa Hệ thống Thông tin\",\n  \"so_dien_thoai\": \"0912345678\",\n  \"dong_y_nghi_dinh_13\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Đăng ký sinh viên bằng email @gm.uit.edu.vn có đối chiếu MSSV và Nghị định 13."
          }
        },
        {
          "name": "1.2 Gửi lại mã OTP Đăng ký",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22521199@gm.uit.edu.vn\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-registration-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "resend-registration-otp"]
            },
            "description": "Gửi lại OTP đăng ký (tối đa 3 lần / 10 phút)."
          }
        },
        {
          "name": "1.3 Xác thực OTP Kích hoạt tài khoản",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22521199@gm.uit.edu.vn\",\n  \"ma_otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-registration-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-registration-otp"]
            },
            "description": "Xác thực OTP 6 số để hoàn tất tạo tài khoản Sinh viên."
          }
        }
      ]
    },
    {
      "name": "2. Đăng nhập & Quản lý Phiên (UC-AUTH-02, 03, 05)",
      "item": [
        {
          "name": "2.1 Đăng nhập bằng Email (Sinh viên / Admin / Tổ chức)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ten_dang_nhap\": \"admin@uit.edu.vn\",\n  \"mat_khau\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập Sanctum SPA Cookie và kích hoạt Single Session nếu là Sinh viên."
          }
        },
        {
          "name": "2.2 Đăng nhập bằng MSSV (Sinh viên)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ten_dang_nhap\": \"22520001\",\n  \"mat_khau\": \"Student@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập trực tiếp bằng MSSV 8 chữ số."
          }
        },
        {
          "name": "2.3 Lấy thông tin cá nhân (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Lấy thông tin người dùng đang đăng nhập (được phép gọi khi buoc_doi_mat_khau = true)."
          }
        },
        {
          "name": "2.4 Cập nhật hồ sơ cá nhân",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"so_dien_thoai\": \"0987654321\",\n  \"avatar_url\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Cập nhật số điện thoại, avatar (bị chặn nếu chưa đổi mật khẩu lần đầu)."
          }
        },
        {
          "name": "2.5 Đổi mật khẩu tài khoản",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mat_khau_hien_tai\": \"Organizer@123\",\n  \"mat_khau_moi\": \"NewSecurePass@123\",\n  \"xac_nhan_mat_khau_moi\": \"NewSecurePass@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Đổi mật khẩu và tự động gỡ bỏ cờ buoc_doi_mat_khau."
          }
        },
        {
          "name": "2.6 Đăng xuất an toàn (/auth/logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Đăng xuất, hủy session DB và làm mất hiệu lực cookie."
          }
        }
      ]
    },
    {
      "name": "3. Khôi phục Mật khẩu qua OTP (UC-AUTH-04)",
      "item": [
        {
          "name": "3.1 Yêu cầu OTP Quên mật khẩu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22520001@gm.uit.edu.vn\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Gửi OTP 6 số qua email (chống email enumeration)."
          }
        },
        {
          "name": "3.2 Xác thực OTP Quên mật khẩu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22520001@gm.uit.edu.vn\",\n  \"ma_otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-forgot-password-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-forgot-password-otp"]
            },
            "description": "Xác thực OTP và trả về reset_token dùng 1 lần."
          }
        },
        {
          "name": "3.3 Đặt lại Mật khẩu mới (Reset Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22520001@gm.uit.edu.vn\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"mat_khau_moi\": \"NewPassword@2026\",\n  \"xac_nhan_mat_khau_moi\": \"NewPassword@2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Đặt lại mật khẩu bằng reset_token hợp lệ."
          }
        }
      ]
    },
    {
      "name": "4. Quản trị & Cấp phát Tài khoản Nội bộ (UC-ADM-01)",
      "item": [
        {
          "name": "4.1 Cấp phát Tài khoản Cán bộ / BTC (Chỉ Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ho_ten\": \"Nguyễn Văn B (BTC Khoa HTTT)\",\n  \"email\": \"btchttt@uit.edu.vn\",\n  \"mat_khau\": \"InitialPass@123\",\n  \"loai_tai_khoan\": \"ToChuc\",\n  \"ma_don_vi_to_chuc\": 1,\n  \"so_dien_thoai\": \"0909112233\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/users/create-internal",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "create-internal"]
            },
            "description": "Admin tạo tài khoản BTC nội bộ, tự động bật buoc_doi_mat_khau = 1 và ghi nhật ký GRANT_ORGANIZER."
          }
        },
        {
          "name": "4.2 Danh sách Người dùng (Chỉ Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"]
            },
            "description": "Lấy danh sách người dùng phân trang."
          }
        }
      ]
    }
  ]
}
