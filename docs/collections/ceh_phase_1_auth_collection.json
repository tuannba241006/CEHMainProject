{
  "info": {
    "_postman_id": "ceh-phase-1-auth-collection-v1",
    "name": "Campus Event Hub (CEH) - Phase 1: Auth & Account Module",
    "description": "Comprehensive Postman Collection for Phase 1: Authentication & Account Management Module (UC-AUTH-01 through UC-AUTH-05, UC-ADM-01). Fully compliant with OpenAPI v3.2.3 and Unified Response Envelope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Student Registration & Activation (UC-AUTH-01)",
      "item": [
        {
          "name": "1.1 Register Student Account via Email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ho_ten\": \"Nguyen Van A\",\n  \"mssv\": \"22521199\",\n  \"email\": \"22521199@gm.uit.edu.vn\",\n  \"mat_khau\": \"SinhVien@123\",\n  \"xac_nhan_mat_khau\": \"SinhVien@123\",\n  \"lop_sinh_hoat\": \"HTTT2022\",\n  \"khoa\": \"Khoa He thong Thong tin\",\n  \"so_dien_thoai\": \"0912345678\",\n  \"dong_y_nghi_dinh_13\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register student account using UIT email (@gm.uit.edu.vn). Enforces MSSV parity with email prefix and Decree 13 consent."
          }
        },
        {
          "name": "1.2 Resend Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22521199@gm.uit.edu.vn\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-registration-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "resend-registration-otp"]
            },
            "description": "Resend registration OTP code (rate limited to max 3 requests per 10-minute sliding window)."
          }
        },
        {
          "name": "1.3 Verify Registration OTP & Activate Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22521199@gm.uit.edu.vn\",\n  \"ma_otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-registration-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-registration-otp"]
            },
            "description": "Verify 6-digit OTP code to complete student account activation."
          }
        }
      ]
    },
    {
      "name": "2. Authentication & Session Management (UC-AUTH-02, 03, 05)",
      "item": [
        {
          "name": "2.1 Login via Email (Admin / Organizer / Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ten_dang_nhap\": \"admin@uit.edu.vn\",\n  \"mat_khau\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login via institutional email address. Issues Sanctum SPA session cookie and enforces Single Active Session for student accounts."
          }
        },
        {
          "name": "2.2 Login via Student ID (MSSV)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ten_dang_nhap\": \"22520001\",\n  \"mat_khau\": \"Student@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login directly using 8-digit Student ID (MSSV)."
          }
        },
        {
          "name": "2.3 Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Retrieve current authenticated user profile. Exempted from initial password change enforcement."
          }
        },
        {
          "name": "2.4 Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"so_dien_thoai\": \"0987654321\",\n  \"avatar_url\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Update phone number and avatar. Blocked with HTTP 403 PASSWORD_CHANGE_REQUIRED if initial password change flag is active."
          }
        },
        {
          "name": "2.5 Change Account Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mat_khau_hien_tai\": \"Organizer@123\",\n  \"mat_khau_moi\": \"NewSecurePass@123\",\n  \"xac_nhan_mat_khau_moi\": \"NewSecurePass@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Change account password and automatically dismiss buoc_doi_mat_khau initial requirement flag."
          }
        },
        {
          "name": "2.6 Safe Logout (/auth/logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Safely invalidate session in database, clear auth guards, and revoke session cookie."
          }
        }
      ]
    },
    {
      "name": "3. Password Recovery via OTP (UC-AUTH-04)",
      "item": [
        {
          "name": "3.1 Request Forgot Password OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22520001@gm.uit.edu.vn\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Dispatch 6-digit recovery OTP via email. Implements anti-enumeration protection."
          }
        },
        {
          "name": "3.2 Verify Forgot Password OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22520001@gm.uit.edu.vn\",\n  \"ma_otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-forgot-password-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-forgot-password-otp"]
            },
            "description": "Verify OTP code and receive a single-use reset_token."
          }
        },
        {
          "name": "3.3 Reset Password via Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"22520001@gm.uit.edu.vn\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"mat_khau_moi\": \"NewPassword@2026\",\n  \"xac_nhan_mat_khau_moi\": \"NewPassword@2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Set a new password using the validated reset_token."
          }
        }
      ]
    },
    {
      "name": "4. Internal Account Administration (UC-ADM-01)",
      "item": [
        {
          "name": "4.1 Provision Internal Organizer/Staff Account (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ho_ten\": \"Nguyen Van B (IS Faculty Organizer)\",\n  \"email\": \"btchttt@uit.edu.vn\",\n  \"mat_khau\": \"InitialPass@123\",\n  \"loai_tai_khoan\": \"ToChuc\",\n  \"ma_don_vi_to_chuc\": 1,\n  \"so_dien_thoai\": \"0909112233\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/users/create-internal",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "create-internal"]
            },
            "description": "Administrator provisions internal staff/organizer account. Automatically enforces initial password change flag and records audit log."
          }
        },
        {
          "name": "4.2 List System Users (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"]
            },
            "description": "Retrieve paginated list of accounts with organization hierarchy information."
          }
        }
      ]
    }
  ]
}
