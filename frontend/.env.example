# Chế độ kết nối API thật với Backend PHP Laravel 12
VITE_APP_MODE=api

# URL gốc của Backend (để trống để dùng reverse proxy /api mặc định qua Nginx / Vite proxy)
VITE_API_URL=

# URL đích chuyển tiếp qua Vite reverse proxy
VITE_BACKEND_URL=http://localhost:8000

# Bật strict mode: lỗi mạng/404 sẽ throw thật, không fallback ngầm mock data (khuyến nghị bật khi UAT & Production)
VITE_STRICT_API=true
