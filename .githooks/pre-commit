#!/bin/sh
# Campus Event Hub - Pre-commit Hook
# Kiểm soát an toàn, chặn file nhạy cảm và nhắc nhở 5 Quy tắc Bất biến (Core Invariants)

echo "🔍 [CEH Git Hook] Đang kiểm tra staged files trước khi commit..."

# 1. Chặn commit các file bí mật / nhạy cảm
SENSITIVE_FILES=$(git diff --cached --name-only | grep -E '(^|/)(\.env(\.(?!example|test\.example|ci\.example)[^/]*)*|.*\.pem|.*\.key|.*credentials.*|.*secret.*\.json)$')

if [ -n "$SENSITIVE_FILES" ]; then
    echo "❌ [ERROR] PHÁT HIỆN FILE NHẠY CẢM ĐƯỢC STAGED:"
    echo "$SENSITIVE_FILES"
    echo "🚨 TUYỆT ĐỐI KHÔNG commit file chứa bí mật hoặc môi trường cục bộ lên Git!"
    echo "Vui lòng chạy: git reset HEAD <file> và kiểm tra lại .gitignore."
    exit 1
fi

# 2. Kiểm tra Test Integrity Soft Harness (Nếu có thay đổi file test)
TEST_DIFF=$(git diff --cached --name-only | grep -E '(^|/)tests/.*')
if [ -n "$TEST_DIFF" ]; then
    echo "⚠️  [TEST HARNESS NOTICE] Phát hiện có thay đổi trong thư mục tests/:"
    echo "$TEST_DIFF"
    echo "   Lưu ý: Tuân thủ nghiêm ngặt Test Integrity Soft Harness (Layer 1: Frozen Specs)."
    echo "   Tuyệt đối không sửa assertion để làm nhẹ bài test!"
fi

# 3. Nhắc nhở 5 Quy tắc Bất biến (Core Invariants)
echo "🔒 [CORE INVARIANTS CHECKLIST]:"
echo "   1. Deadlock-free Lock Ordering: tai_khoan -> phong_hoi_truong -> dat_phong -> su_kien -> dang_ky -> hang_doi_waitlist"
echo "   2. Pessimistic Locking: Luôn dùng selectForUpdate() khi xử lý tranh chấp vé/phòng"
echo "   3. Unified Error Envelope: Format đúng { success: false, error: { code, details }, message }"
echo "   4. Timezone ISO 8601: Luôn dùng UTC/GMT+7 chuẩn ISO"
echo "   5. Test Circumvention Zero Tolerance: Không ngụy tạo nghiệm thu"

echo "✅ [CEH Pre-commit] Kiểm tra hoàn tất. Cho phép commit."
exit 0
